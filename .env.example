# Copy to apps/backend/.env and adjust. Placeholder values only — never commit real secrets.

# Postgres from docker-compose (`docker compose up -d`). The password must match POSTGRES_PASSWORD
# (docker-compose defaults it to change-me-locally). Required by `npm run dev` and `npm test`.
DATABASE_URL=postgres://flower:YOUR_PASSWORD_HERE@localhost:5433/flower_shop
# Optional: a different server for tests. Each test file creates and drops its own flower_test_* database there.
# TEST_DATABASE_URL=postgres://flower:YOUR_PASSWORD_HERE@localhost:5433/flower_shop

# Origin of the web app; state-changing API requests from other origins are rejected.
WEB_ORIGIN=http://localhost:5173

API_PORT=3001
NODE_ENV=development
