# Copy to apps/server/.env and adjust. Placeholder values only — never commit real secrets.

# Leave unset to use the bundled PGlite dev database (apps/server/.pglite/),
# reachable by DB viewers at postgres://postgres:postgres@127.0.0.1:54320/postgres while `npm run dev` runs.
# PGLITE_PORT=54320
# To use a real Postgres:
#   Homebrew (`brew install postgresql@16 && brew services start postgresql@16 && createdb flower_shop`):
# DATABASE_URL=postgres://localhost:5432/flower_shop
#   Docker (`docker compose up -d`):
# DATABASE_URL=postgres://flower:YOUR_PASSWORD_HERE@localhost:5432/flower_shop

# Origin of the web app; state-changing API requests from other origins are rejected.
WEB_ORIGIN=http://localhost:5173

API_PORT=3001
NODE_ENV=development
